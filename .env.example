# 复制成 .env 后填入真实值，并收紧权限
#   cp .env.example .env && chmod 600 .env

# ---------- MiniMax 模型密钥（必填）----------
# 中国大陆区：https://platform.minimaxi.com/user-center/basic-information/interface-key
# 国际区：    https://platform.minimax.io/user-center/basic-information/interface-key
# ⚠️ key 不能跨区域使用。国内 key 只能打 api.minimaxi.com，国际 key 只能打 api.minimax.io。
MINIMAX_API_KEY=

# ---------- 小米账号凭据 ----------
# 由 tools/setup_wizard.py 自动写入，保留原样即可
MI_USER=
MI_PASS=
MI_DID=
